generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InterventionStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  ON_HOLD
  RESOLVED
  CANCELLED
  REJECTED
}

enum InterventionType {
  ISSUE
  PREVENTIVE
}

enum RecurringPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ReportStatus {
  DRAFT
  FINALIZED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AssignmentMethod {
  MANUAL
  AUTOMATIC
}

enum ExecutionConfirmationStatus {
  NOT_REQUESTED
  PENDING
  CONFIRMED
  REJECTED
  CLOSED_WITHOUT_CONFIRMATION
}

enum ExecutionConfirmationMethod {
  PIN
  SIGNATURE
  NONE
}

enum NotificationType {
  NEW_REPORT
  INTERVENTION_ASSIGNED
  STATUS_CHANGED
  FEEDBACK_REQUEST
  AUTO_ASSIGNMENT
  NEW_TICKET
  TICKET_REPLY
  INTERVENTION_PAUSED
  EXECUTION_CONFIRMATION_REQUEST
  EXECUTION_CONFIRMATION_RESPONSE
}

enum PauseReason {
  WAITING_FOR_CUSTOMER
  WAITING_FOR_MATERIAL
  WAITING_FOR_EXTERNAL_CONTRACTOR
  WAITING_FOR_APPROVAL
  OTHER
}

enum CompanyStatus {
  PENDING
  ACTIVE
  REJECTED
  INACTIVE
}

model Company {
  id            Int              @id @default(autoincrement())
  name          String           @unique
  contact       String?
  type          String?
  email         String?          @unique
  phone         String?
  address       String?
  identificationNumber String?   @unique
  status        CompanyStatus    @default(ACTIVE)
  adminUserId   Int?             @unique
  adminUser     User?            @relation("CompanyAdmin", fields: [adminUserId], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  users         User[]           @relation("CompanyUsers")
  faultReports  FaultReport[]
  interventions Intervention[]
  blocks        UserBlock[]
}

model User {
  id                   Int                     @id @default(autoincrement())
  firstName            String
  lastName             String
  username             String                  @unique
  email                String                  @unique
  language             String                  @default("en") @db.VarChar(10)
  active               Boolean                 @default(true)
  companyId            Int?
  company              Company?                @relation("CompanyUsers", fields: [companyId], references: [id], onDelete: SetNull)
  administeredCompany  Company?                @relation("CompanyAdmin")
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  externalIdentities    ExternalIdentity[]
  passwordResetTokens   PasswordResetToken[]
  createdFaultReports   FaultReport[]           @relation("FaultReportAuthor")
  createdInterventions  Intervention[]          @relation("InterventionCreator")
  reports              Report[]                @relation("ReportAuthor")
  recommendedReports   Report[]                @relation("ReportRecommendedBy")
  assignments          Assignment[]
  comments             InterventionComment[]   @relation("CommentAuthor")
  statusChanges        StatusHistory[]         @relation("StatusHistoryAuthor")
  requestedExecutionConfirmations ExecutionConfirmation[] @relation("ExecutionConfirmationRequester")
  confirmedExecutionConfirmations ExecutionConfirmation[] @relation("ExecutionConfirmationConfirmer")
  updatedConfigs       SystemConfig[]          @relation("SystemConfigEditor")
  tickets              Ticket[]
  messages             Message[]               @relation("MessageAuthor")
  feedbacks            Feedback[]
  notifications        Notification[]
  blocksReceived       UserBlock[]             @relation("BlockedUser")
  blocksMade           UserBlock[]             @relation("BlockCreatedBy")
  preferences          UserPreference?
  unavailablePeriods   ServicerUnavailability[] @relation("ServicerUnavailablePeriods")
  pauseActions         InterventionPause[]      @relation("PauseActor")
  pauseResponsibilities InterventionPause[]     @relation("PauseResponsibleUser")
}

model UserPreference {
  id                     Int      @id @default(autoincrement())
  userId                 Int      @unique
  language               String   @default("en")
  notificationPreferences Json
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id            Int      @id @default(autoincrement())
  action        String
  entity        String
  entityId      String?
  actorId       Int?
  actorUsername String?
  details       String?  @db.LongText
  oldValues     Json?
  newValues     Json?
  createdAt     DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
}

model ExternalIdentity {
  id              Int      @id @default(autoincrement())
  userId          Int
  provider        String
  providerSubject String
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
}

model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Category {
  id            Int             @id @default(autoincrement())
  name          String          @unique
  description   String?
  active        Boolean         @default(true)
  createdByName String?
  updatedByName String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  faultReports  FaultReport[]
  interventions Intervention[]
}

model FaultReport {
  id            Int            @id @default(autoincrement())
  description   String
  location      String         @db.VarChar(500)
  latitude      Decimal?       @db.Decimal(10, 7)
  longitude     Decimal?       @db.Decimal(10, 7)
  reportedAt    DateTime       @default(now())
  userId        Int?
  user          User?          @relation("FaultReportAuthor", fields: [userId], references: [id], onDelete: SetNull)
  categoryId    Int
  category      Category       @relation(fields: [categoryId], references: [id])
  companyId     Int
  company       Company        @relation(fields: [companyId], references: [id])
  attachments   Attachment[]
  interventions Intervention[]
}

model Intervention {
  id                Int                @id @default(autoincrement())
  name              String
  description       String
  location          String             @db.VarChar(500)
  latitude          Decimal?           @db.Decimal(10, 7)
  longitude         Decimal?           @db.Decimal(10, 7)
  priority          Priority           @default(MEDIUM)
  status            InterventionStatus @default(NEW)
  type              InterventionType   @default(ISSUE)
  archived          Boolean            @default(false)
  createdAt         DateTime           @default(now())
  startedAt         DateTime?
  dueAt             DateTime?
  recurringPeriod   RecurringPeriod?
  nextGenerationAt  DateTime?
  categoryId        Int
  category          Category           @relation(fields: [categoryId], references: [id])
  creatorId         Int
  creator           User               @relation("InterventionCreator", fields: [creatorId], references: [id])
  companyId         Int
  company           Company            @relation(fields: [companyId], references: [id])
  faultReportId     Int?
  faultReport       FaultReport?       @relation(fields: [faultReportId], references: [id], onDelete: SetNull)
  reports           Report[]
  assignments       Assignment[]
  attachments       Attachment[]
  comments          InterventionComment[]
  statusHistory     StatusHistory[]
  feedback          Feedback?
  executionConfirmation ExecutionConfirmation?
  notifications     Notification[]
  pauses            InterventionPause[]
}

model ServicerUnavailability {
  id          Int       @id @default(autoincrement())
  userId      Int
  startAt     DateTime
  endAt       DateTime
  reason      String    @db.VarChar(500)
  canceledAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation("ServicerUnavailablePeriods", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt, endAt])
  @@index([canceledAt])
}

model InterventionPause {
  id                    Int                @id @default(autoincrement())
  interventionId         Int
  pausedById             Int
  responsibleUserId      Int?
  reason                 PauseReason
  otherReason            String?            @db.VarChar(1000)
  previousStatus         InterventionStatus
  pausedAt               DateTime           @default(now())
  resumedAt              DateTime?
  resumedById            Int?
  resumeNote             String?            @db.VarChar(1000)
  intervention           Intervention       @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  pausedBy               User               @relation("PauseActor", fields: [pausedById], references: [id])
  responsibleUser        User?              @relation("PauseResponsibleUser", fields: [responsibleUserId], references: [id], onDelete: SetNull)

  @@index([interventionId, resumedAt])
  @@index([reason])
  @@index([pausedAt])
}

model ExecutionConfirmation {
  id              Int                         @id @default(autoincrement())
  interventionId  Int                         @unique
  requestedById   Int?
  confirmedById   Int?
  status          ExecutionConfirmationStatus @default(PENDING)
  method          ExecutionConfirmationMethod?
  pinHash         String?
  signatureData   String?                     @db.LongText
  rejectionReason String?                     @db.LongText
  bypassReason    String?                     @db.LongText
  requestedAt     DateTime                    @default(now())
  respondedAt     DateTime?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  intervention    Intervention                @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  requestedBy     User?                       @relation("ExecutionConfirmationRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  confirmedBy     User?                       @relation("ExecutionConfirmationConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([requestedById])
  @@index([confirmedById])
}

model Report {
  id            Int            @id @default(autoincrement())
  interventionId Int
  authorId      Int
  description   String         @db.LongText
  material      String?        @db.LongText
  notes         String?        @db.LongText
  reportDate    DateTime       @default(now())
  status        ReportStatus   @default(DRAFT)
  isRecommended Boolean        @default(false)
  recommendedAt DateTime?
  recommendedById Int?
  intervention  Intervention   @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  author        User           @relation("ReportAuthor", fields: [authorId], references: [id])
  recommendedBy User?          @relation("ReportRecommendedBy", fields: [recommendedById], references: [id], onDelete: SetNull)
  attachments   Attachment[]

  @@index([isRecommended])
}

model Attachment {
  id            Int            @id @default(autoincrement())
  url           String
  storageKey    String?
  fileName      String
  mimeType      String
  fileSize      Int
  createdAt     DateTime       @default(now())
  interventionId Int?
  intervention  Intervention?  @relation(fields: [interventionId], references: [id], onDelete: SetNull)
  faultReportId  Int?
  faultReport    FaultReport?   @relation(fields: [faultReportId], references: [id], onDelete: SetNull)
  reportId      Int?
  report        Report?        @relation(fields: [reportId], references: [id], onDelete: SetNull)
}

model Assignment {
  id            Int              @id @default(autoincrement())
  interventionId Int
  userId        Int
  method        AssignmentMethod @default(MANUAL)
  assignedAt    DateTime         @default(now())
  intervention  Intervention     @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id])

  @@unique([interventionId, userId])
}

model TicketCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]

  @@index([active, name])
}

model Ticket {
  id          Int         @id @default(autoincrement())
  userId      Int
  title       String
  categoryId  Int
  status      TicketStatus @default(OPEN)
  userBlocked Boolean     @default(false)
  userBlockedReason String? @db.LongText
  userBlockedAt DateTime?
  userBlockedById Int?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    TicketCategory @relation(fields: [categoryId], references: [id])
  messages    Message[]
  notifications Notification[]

  @@index([categoryId])
}

model Message {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  text      String   @db.LongText
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation("MessageAuthor", fields: [authorId], references: [id])
}

model Feedback {
  id            Int          @id @default(autoincrement())
  interventionId Int          @unique
  userId        Int
  rating        Int
  comment       String?
  createdAt     DateTime     @default(now())
  intervention  Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id])
}

model InterventionComment {
  id            Int          @id @default(autoincrement())
  interventionId Int
  authorId      Int
  text          String       @db.LongText
  createdAt     DateTime     @default(now())
  intervention  Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  author        User         @relation("CommentAuthor", fields: [authorId], references: [id])
}

model StatusHistory {
  id            Int                @id @default(autoincrement())
  interventionId Int
  authorId      Int
  oldStatus     InterventionStatus
  newStatus     InterventionStatus
  changedAt     DateTime           @default(now())
  intervention  Intervention       @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  author        User               @relation("StatusHistoryAuthor", fields: [authorId], references: [id])
}

model SystemConfig {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String   @db.LongText
  updatedById  Int?
  updatedBy    User?    @relation("SystemConfigEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt    DateTime @updatedAt
}

model SlaConfiguration {
  id            Int      @id @default(autoincrement())
  priority      Priority @unique
  deadlineHours Int
  updatedAt     DateTime @updatedAt
}

model UserBlock {
  id             Int      @id @default(autoincrement())
  userId         Int
  companyId      Int
  coordinatorId  Int
  reason         String   @db.LongText
  blockedAt      DateTime @default(now())
  blockedUser    User     @relation("BlockedUser", fields: [userId], references: [id], onDelete: Cascade)
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  coordinator    User     @relation("BlockCreatedBy", fields: [coordinatorId], references: [id])
}

model Notification {
  id            Int               @id @default(autoincrement())
  userId        Int
  title         String
  text          String            @db.LongText
  type          NotificationType
  read          Boolean           @default(false)
  interventionId Int?
  ticketId      Int?
  createdAt     DateTime          @default(now())
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  intervention  Intervention?     @relation(fields: [interventionId], references: [id], onDelete: SetNull)
  ticket        Ticket?           @relation(fields: [ticketId], references: [id], onDelete: SetNull)
}

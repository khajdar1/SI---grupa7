generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum InterventionStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CANCELLED
  REJECTED
}

enum InterventionType {
  ISSUE
  PREVENTIVE
}

enum RecurringPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum ReportStatus {
  DRAFT
  FINALIZED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum AssignmentMethod {
  MANUAL
  AUTOMATIC
}

enum NotificationType {
  NEW_REPORT
  INTERVENTION_ASSIGNED
  STATUS_CHANGED
  FEEDBACK_REQUEST
  AUTO_ASSIGNMENT
  NEW_TICKET
  TICKET_REPLY
}

model Company {
  id           Int              @id @default(autoincrement())
  name         String           @unique
  contact      String?
  type         String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  users        User[]           @relation("CompanyUsers")
  faultReports FaultReport[]
  interventions Intervention[]
  blocks       UserBlock[]
}

model User {
  id                   Int                     @id @default(autoincrement())
  firstName            String
  lastName             String
  username             String                  @unique
  email                String                  @unique
  active               Boolean                 @default(true)
  companyId            Int?
  company              Company?                @relation("CompanyUsers", fields: [companyId], references: [id], onDelete: SetNull)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  externalIdentities    ExternalIdentity[]
  createdFaultReports   FaultReport[]           @relation("FaultReportAuthor")
  createdInterventions  Intervention[]          @relation("InterventionCreator")
  reports              Report[]                @relation("ReportAuthor")
  assignments          Assignment[]
  comments             InterventionComment[]   @relation("CommentAuthor")
  statusChanges        StatusHistory[]         @relation("StatusHistoryAuthor")
  updatedConfigs       SystemConfig[]          @relation("SystemConfigEditor")
  tickets              Ticket[]
  messages             Message[]               @relation("MessageAuthor")
  feedbacks            Feedback[]
  notifications        Notification[]
  blocksReceived       UserBlock[]             @relation("BlockedUser")
  blocksMade           UserBlock[]             @relation("BlockCreatedBy")
}

model ExternalIdentity {
  id              Int      @id @default(autoincrement())
  userId          Int
  provider        String
  providerSubject String
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
}

model Category {
  id            Int             @id @default(autoincrement())
  name          String          @unique
  description   String?
  active        Boolean         @default(true)
  createdByName String?
  updatedByName String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  faultReports  FaultReport[]
  interventions Intervention[]
}

model FaultReport {
  id            Int            @id @default(autoincrement())
  description   String
  location      String
  latitude      Decimal?       @db.Decimal(10, 7)
  longitude     Decimal?       @db.Decimal(10, 7)
  reportedAt    DateTime       @default(now())
  userId        Int?
  user          User?          @relation("FaultReportAuthor", fields: [userId], references: [id], onDelete: SetNull)
  categoryId    Int
  category      Category       @relation(fields: [categoryId], references: [id])
  companyId     Int
  company       Company        @relation(fields: [companyId], references: [id])
  attachments   Attachment[]
  interventions Intervention[]
}

model Intervention {
  id                Int                @id @default(autoincrement())
  name              String
  description       String
  location          String
  latitude          Decimal?           @db.Decimal(10, 7)
  longitude         Decimal?           @db.Decimal(10, 7)
  priority          Priority           @default(MEDIUM)
  status            InterventionStatus @default(NEW)
  type              InterventionType   @default(ISSUE)
  archived          Boolean            @default(false)
  createdAt         DateTime           @default(now())
  startedAt         DateTime?
  dueAt             DateTime?
  recurringPeriod   RecurringPeriod?
  nextGenerationAt  DateTime?
  categoryId        Int
  category          Category           @relation(fields: [categoryId], references: [id])
  creatorId         Int
  creator           User               @relation("InterventionCreator", fields: [creatorId], references: [id])
  companyId         Int
  company           Company            @relation(fields: [companyId], references: [id])
  faultReportId     Int?
  faultReport       FaultReport?       @relation(fields: [faultReportId], references: [id], onDelete: SetNull)
  reports           Report[]
  assignments       Assignment[]
  attachments       Attachment[]
  comments          InterventionComment[]
  statusHistory     StatusHistory[]
  feedback          Feedback?
  notifications     Notification[]
}

model Report {
  id            Int            @id @default(autoincrement())
  interventionId Int
  authorId      Int
  description   String         @db.LongText
  material      String?        @db.LongText
  notes         String?        @db.LongText
  reportDate    DateTime       @default(now())
  status        ReportStatus   @default(DRAFT)
  intervention  Intervention   @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  author        User           @relation("ReportAuthor", fields: [authorId], references: [id])
  attachments   Attachment[]
}

model Attachment {
  id            Int            @id @default(autoincrement())
  url           String
  storageKey    String?
  fileName      String
  mimeType      String
  fileSize      Int
  createdAt     DateTime       @default(now())
  interventionId Int?
  intervention  Intervention?  @relation(fields: [interventionId], references: [id], onDelete: SetNull)
  faultReportId  Int?
  faultReport    FaultReport?   @relation(fields: [faultReportId], references: [id], onDelete: SetNull)
  reportId      Int?
  report        Report?        @relation(fields: [reportId], references: [id], onDelete: SetNull)
}

model Assignment {
  id            Int              @id @default(autoincrement())
  interventionId Int
  userId        Int
  method        AssignmentMethod @default(MANUAL)
  assignedAt    DateTime         @default(now())
  intervention  Intervention     @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  user          User             @relation(fields: [userId], references: [id])

  @@unique([interventionId, userId])
}

model Ticket {
  id          Int         @id @default(autoincrement())
  userId      Int
  title       String
  category    String
  status      TicketStatus @default(OPEN)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    Message[]
  notifications Notification[]
}

model Message {
  id        Int      @id @default(autoincrement())
  ticketId  Int
  authorId  Int
  text      String   @db.LongText
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author    User     @relation("MessageAuthor", fields: [authorId], references: [id])
}

model Feedback {
  id            Int          @id @default(autoincrement())
  interventionId Int          @unique
  userId        Int
  rating        Int
  comment       String?
  createdAt     DateTime     @default(now())
  intervention  Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id])
}

model InterventionComment {
  id            Int          @id @default(autoincrement())
  interventionId Int
  authorId      Int
  text          String       @db.LongText
  createdAt     DateTime     @default(now())
  intervention  Intervention @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  author        User         @relation("CommentAuthor", fields: [authorId], references: [id])
}

model StatusHistory {
  id            Int                @id @default(autoincrement())
  interventionId Int
  authorId      Int
  oldStatus     InterventionStatus
  newStatus     InterventionStatus
  changedAt     DateTime           @default(now())
  intervention  Intervention       @relation(fields: [interventionId], references: [id], onDelete: Cascade)
  author        User               @relation("StatusHistoryAuthor", fields: [authorId], references: [id])
}

model SystemConfig {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String   @db.LongText
  updatedById  Int?
  updatedBy    User?    @relation("SystemConfigEditor", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt    DateTime @updatedAt
}

model SlaConfiguration {
  id            Int      @id @default(autoincrement())
  priority      Priority @unique
  deadlineHours Int
  updatedAt     DateTime @updatedAt
}

model UserBlock {
  id             Int      @id @default(autoincrement())
  userId         Int
  companyId      Int
  coordinatorId  Int
  reason         String   @db.LongText
  blockedAt      DateTime @default(now())
  blockedUser    User     @relation("BlockedUser", fields: [userId], references: [id], onDelete: Cascade)
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  coordinator    User     @relation("BlockCreatedBy", fields: [coordinatorId], references: [id])
}

model Notification {
  id            Int               @id @default(autoincrement())
  userId        Int
  title         String
  text          String            @db.LongText
  type          NotificationType
  read          Boolean           @default(false)
  interventionId Int?
  ticketId      Int?
  createdAt     DateTime          @default(now())
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  intervention  Intervention?     @relation(fields: [interventionId], references: [id], onDelete: SetNull)
  ticket        Ticket?           @relation(fields: [ticketId], references: [id], onDelete: SetNull)
}
